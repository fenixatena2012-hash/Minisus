generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  sentFriends  Friendship[] @relation("FriendSender")
  gotFriends   Friendship[] @relation("FriendReceiver")
}
model Friendship {
  id         String @id @default(cuid())
  senderId   String
  receiverId String
  status     String @default("PENDING")
  sender     User @relation("FriendSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User @relation("FriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([senderId, receiverId])
}
